            <xpath>Defs/BiomeDef[defName="TKKN_VolcanicFlow"]/terrainPatchMakers/li/thresholds</xpath>
            <value>
                <thresholds>
                    <li>
                        <terrain>TKKN_LavaRock_RoughHewn</terrain>
