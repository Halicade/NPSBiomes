            <li>Salt</li>
        </value>
    </Operation>

    <Operation Class="PatchOperationConditional">
        <xpath>Defs/TerrainDef[defName="VEE_SaltySand"]/tags</xpath>
        <nomatch Class="PatchOperationAdd">
            <xpath>Defs/TerrainDef[defName="VEE_SaltySand"]</xpath>
            <value>
                <tags />
            </value>
        </nomatch>
    </Operation>

    <!-- add pyromaniac caravan handler comp to Caravan WorldObjectDef -->
    <Operation Class="PatchOperationAdd">
        <xpath>Defs/TerrainDef[defName="VEE_SaltySand"]/tags</xpath>
        <value>
            <li>Salt</li>
        </value>
    </Operation>

</Patch>